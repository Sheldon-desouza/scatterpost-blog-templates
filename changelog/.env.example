# Public base URL of this deployed site, used to build canonical links,
# the RSS feed, the sitemap, llms.txt, and the { url } this site returns
# to scatterpost on a push-mode publish.
NEXT_PUBLIC_SITE_URL=

# Product name and one-line description, used on the home page, in page
# titles, Open Graph and Twitter meta, the feeds and the JSON-LD on
# every page. Both have sane defaults if unset.
SITE_NAME=
SITE_DESCRIPTION=

# Name and URL of the author, used in the JSON-LD on every page.
# AUTHOR_URL is optional; AUTHOR_NAME defaults to SITE_NAME.
AUTHOR_NAME=
AUTHOR_URL=

# Comma-separated list of other profiles for the author or organisation
# (GitHub, LinkedIn, X, and so on), https only. Feeds the "sameAs" field
# of the Person/Organization JSON-LD on the home page, so search
# engines and AI assistants can connect this site to those profiles.
SAME_AS=

# Shared secret for the website connection, set when you connect this
# site as a Website channel in scatterpost. Verifies the
# X-Scatterpost-Signature header on POST /api/scatterpost (push mode).
# Minimum 32 characters.
SCATTERPOST_WEBHOOK_SECRET=

# An sp_live_... scatterpost API key, scoped to your workspace. Only
# needed for pull mode (scripts/pull.mjs and the /api/scatterpost/pull
# route poll GET /api/v1/publications with it).
SCATTERPOST_API_KEY=

# Base URL of the scatterpost API, e.g. https://app.scatterpost.io. Only
# needed for pull mode.
SCATTERPOST_API_URL=

# Shared secret checked on the pull-mode cron route
# (/api/scatterpost/pull). Vercel sends this automatically as
# `Authorization: Bearer <CRON_SECRET>` for a scheduled job, when the env
# var is named exactly CRON_SECRET. Only needed for pull mode.
CRON_SECRET=

# Where posts are written: "blob" (default on Vercel once a Blob store
# is connected, writes posts/*.md through @vercel/blob), "file" (default
# otherwise, writes content/posts/*.md, fine for local dev only, since
# Vercel's production filesystem is read-only) or "supabase" (writes the
# posts table from supabase/posts.sql, an optional alternative to Blob).
CONTENT_STORE=

# Set automatically when a Vercel Blob store is connected to this
# project; needed for CONTENT_STORE=blob (or left at its default on
# Vercel). Not needed for local dev with the file store.
BLOB_READ_WRITE_TOKEN=

# Only needed when CONTENT_STORE=supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional GA4 analytics, gated behind a consent banner (UK PECR): set
# this to load gtag.js, but only after a visitor clicks Accept. Leave
# unset for no banner, no script and no cookie at all. Format
# "G-XXXXXXXXXX".
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Verification codes for Google Search Console and Bing Webmaster
# Tools, rendered as <meta> tags by every page so you can verify
# ownership without editing any file. Optional.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional IndexNow key (8 to 128 characters of a-z, A-Z, 0-9 and -),
# pinging https://api.indexnow.org/indexnow after every publish so Bing
# (and the AI assistants it feeds) can pick up the new post sooner.
# Leave unset to skip IndexNow entirely; the key is also served back at
# /{key}.txt, which IndexNow checks to confirm you own this site.
INDEXNOW_KEY=
