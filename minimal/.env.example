# Public base URL of this deployed site, used to build canonical links,
# the RSS feed, the sitemap, llms.txt, and the { url } this site returns
# to scatterpost on a push-mode publish.
NEXT_PUBLIC_SITE_URL=

# Name of the site and its author, used in page titles, Open Graph and
# Twitter meta, and the JSON-LD on every page. AUTHOR_URL is optional.
SITE_NAME=
AUTHOR_NAME=
AUTHOR_URL=

# Comma-separated list of other profiles for the author or organisation
# (GitHub, LinkedIn, X, and so on), https only. Feeds the "sameAs" field
# of the Person/Organization JSON-LD on the home page, so search
# engines and AI assistants can connect this site to those profiles.
SAME_AS=

# Shared secret for the website connection, set when you connect this
# site as a Website channel in scatterpost. Verifies the
# X-Scatterpost-Signature header on POST /api/scatterpost (push mode).
# Minimum 32 characters.
SCATTERPOST_WEBHOOK_SECRET=

# An sp_live_... scatterpost API key, scoped to your workspace. Only
# needed for pull mode (scripts/pull.mjs and the /api/scatterpost/pull
# route poll GET /api/v1/publications with it).
SCATTERPOST_API_KEY=

# Base URL of the scatterpost API, e.g. https://app.scatterpost.io. Only
# needed for pull mode.
SCATTERPOST_API_URL=

# Shared secret checked on the pull-mode cron route
# (/api/scatterpost/pull). Vercel sends this automatically as
# `Authorization: Bearer <CRON_SECRET>` for a scheduled job, when the env
# var is named exactly CRON_SECRET. Only needed for pull mode.
CRON_SECRET=

# Where posts are written: "blob" (default on Vercel once a Blob store
# is connected, writes posts/*.md through @vercel/blob), "file" (default
# otherwise, writes content/posts/*.md, fine for local dev only, since
# Vercel's production filesystem is read-only) or "supabase" (writes the
# posts table from supabase/posts.sql, an optional alternative to Blob).
CONTENT_STORE=

# Set automatically when a Vercel Blob store is connected to this
# project; needed for CONTENT_STORE=blob (or left at its default on
# Vercel). Not needed for local dev with the file store.
BLOB_READ_WRITE_TOKEN=

# Only needed when CONTENT_STORE=supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional GA4 analytics, gated behind a consent banner (UK PECR): set
# this to load gtag.js, but only after a visitor clicks Accept. Leave
# unset for no banner, no script and no cookie at all. Format
# "G-XXXXXXXXXX".
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Verification codes for Google Search Console and Bing Webmaster
# Tools, rendered as <meta> tags by every page so you can verify
# ownership without editing any file. Optional.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional IndexNow key (8 to 128 characters of a-z, A-Z, 0-9 and -),
# pinging https://api.indexnow.org/indexnow after every publish so Bing
# (and the AI assistants it feeds) can pick up the new post sooner.
# Leave unset to skip IndexNow entirely; the key is also served back at
# /{key}.txt, which IndexNow checks to confirm you own this site.
INDEXNOW_KEY=

# Set to exactly "false" to hide the "Built with a scatterpost
# template" footer credit. Shown by default: it costs nothing to
# leave on and it is how other founders find the templates.
NEXT_PUBLIC_SHOW_SCATTERPOST_CREDIT=

# Demo mode: none of these are needed to run your own blog. They exist
# so this same template can also serve as a live demo under a path on
# demo.scatterpost.io.
#
# NEXT_PUBLIC_BASE_PATH: optional URL path prefix (e.g. "/minimal") this
# whole site is served under. Leave unset; every absolute URL this site
# builds (canonical, RSS, sitemap, llms.txt) already comes from
# NEXT_PUBLIC_SITE_URL, so set the two together or not at all.
NEXT_PUBLIC_BASE_PATH=

# NEXT_PUBLIC_POSTS_AT_ROOT: set to exactly "true" to put the post
# listing at the root of the site and each post at /<slug> instead of
# /blog/<slug>. Meant for a blog that is already served under a path of
# its own: for example.com/blog, set NEXT_PUBLIC_BASE_PATH=/blog,
# NEXT_PUBLIC_SITE_URL=https://example.com/blog and this to "true", and
# a post lives at example.com/blog/<slug> rather than
# example.com/blog/blog/<slug>. The old /blog and /blog/<slug> URLs then
# permanently redirect (308) to the new ones, and a post title that
# would become a slug already taken by a page of this site (blog, api,
# tags, feed.xml and so on) is refused with a clear error instead of
# being published. Leave unset to keep posts under /blog.
NEXT_PUBLIC_POSTS_AT_ROOT=

# NEXT_PUBLIC_DEMO_TEMPLATE: set to this template's display name (e.g.
# "Minimal") to show a slim bar above the header reading "You are
# viewing the <name> template.", with links to deploy it and to see all
# templates. Leave unset for your own blog: no flag, no bar.
NEXT_PUBLIC_DEMO_TEMPLATE=

# NEXT_PUBLIC_DEMO_DEPLOY_URL, NEXT_PUBLIC_DEMO_GALLERY_URL: override
# the demo bar's two links. Both optional: the deploy link falls back to
# this template's own "Deploy with Vercel" URL from this README, and the
# gallery link falls back to https://demo.scatterpost.io/.
NEXT_PUBLIC_DEMO_DEPLOY_URL=
NEXT_PUBLIC_DEMO_GALLERY_URL=

# NEXT_PUBLIC_DEMO_SEED_CONTENT: set to exactly "true" to also list the
# committed sample posts under demo-content/posts alongside whatever is
# in content/posts, so a demo deploy has something to show before (or
# instead of) a real scatterpost connection. Separate from
# NEXT_PUBLIC_DEMO_TEMPLATE on purpose, so a demo can turn seeding off
# once real posts exist without also hiding the bar. Leave unset for
# your own blog: no flag, no seeded posts, content/posts untouched.
NEXT_PUBLIC_DEMO_SEED_CONTENT=
