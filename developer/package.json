{
  "name": "scatterpost-blog-developer",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "An engineering-notebook Next.js blog template for a technical founder, with syntax-highlighted code blocks, a table of contents, tag pages and a theme toggle, and the scatterpost website connector pre-wired. Self-contained: no dependency on any scatterpost package at runtime.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "pull": "node scripts/pull.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@vercel/blob": "2.8.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.14",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "shiki": "^1.24.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
